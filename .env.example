# Server only. Never prefix these with VITE_, and never import them from src/.
# Leave AMP_QUERY_URL empty to run with demo data only.
AMP_QUERY_URL=
AMP_QUERY_TOKEN=
# Where a dataset's fingerprint is read from, with the same token. Defaults to AMP_QUERY_URL's /controller.
AMP_ADMIN_URL=

# Raw Base dataset to read from.
PRICETAG_BASE_DATASET=edgeandnode/base_mainnet@0.0.2
# Pricetag dataset (see dataset/) to read from. Leave empty to derive the same rows from the raw dataset at query time.
PRICETAG_DATASET=
# Oracle reads use this network name in rpc.<network>.eth_call.
PRICETAG_RPC_NETWORK=base_mainnet
# How far back a wallet's history goes, in blocks (2 s each), when reading the raw dataset. `pnpm amp:start` starts this far back too.
PRICETAG_HISTORY_BLOCKS=1800
# First block of the Pricetag dataset. Required with PRICETAG_DATASET.
PRICETAG_START_BLOCK=
PORT=8787

# The server reads L1 fees from this RPC's receipts, and `pnpm amp:start` follows the chain with it. Defaults to the
# public RPC, which rate-limits. Use a dedicated one for a demo.
BASE_RPC_URL=
# Requests a second for `pnpm amp:start` to send it. Defaults to 20, to stay under the public RPC's 25. Raise it for a dedicated one.
BASE_RPC_RATE_LIMIT=

# A second pricing rule, which adds a switch to both apps. See "Forking a pricing rule" in the README. It needs an Amp that
# reads the amp-alias header, and the manifest hash of both datasets: queries are pinned to them, so a wrong one fails.
PRICETAG_DATASET_HASH=
PRICETAG_FORK_DATASET=
PRICETAG_FORK_HASH=

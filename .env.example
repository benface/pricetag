# Server only. Never prefix these with VITE_, and never import them from src/.
# Leave AMP_QUERY_URL empty to run with demo data only.
AMP_QUERY_URL=
AMP_QUERY_TOKEN=
# Where a dataset's fingerprint is read from, with the same token. Defaults to AMP_QUERY_URL's /controller.
AMP_ADMIN_URL=

# Raw Base dataset to read from.
PRICETAG_BASE_DATASET=edgeandnode/base_mainnet@0.0.2
# Pricetag dataset (see dataset/) to read from. Leave empty to derive the same rows from the raw dataset at query time.
PRICETAG_DATASET=
# Dataset of exchange rate updates (dataset/rates.json) to read rates from. Leave empty to read them from Chainlink's contracts with eth_call, which is the only way on a local Amp.
PRICETAG_RATES_DATASET=
# Reads that still use eth_call (the raw dataset's prices, exchange rates without a rates dataset, balances) use this network name in rpc.<network>.eth_call.
PRICETAG_RPC_NETWORK=base_mainnet
# How far back a wallet's history goes, in blocks, when reading the raw dataset. Empty means an hour.
# `pnpm amp:start` starts this far back too, or 1,800 blocks if it's empty, because each block costs RPC requests.
PRICETAG_HISTORY_BLOCKS=
# First block of the Pricetag dataset. Required with PRICETAG_DATASET.
PRICETAG_START_BLOCK=
PORT=8787

# The server reads L1 fees from this RPC's receipts and checks Chainlink's feeds with it, and `pnpm amp:start` follows the chain with it. Defaults to the
# public RPC, which rate-limits. Use a dedicated one for a demo.
BASE_RPC_URL=
# Requests a second it allows. Defaults to the public RPC's 25. Raise it for a dedicated one. `pnpm amp:start` sends up to 60% of this, and following the
# head takes about 10 a second, so don't go below 17. The server reads L1 fees with the other 40%, so a wallet sending many transactions a second can catch up.
BASE_RPC_RATE_LIMIT=

# A second pricing rule, which adds a switch to both apps. See "Forking a pricing rule" in the README. It needs an Amp that
# reads the amp-alias header, and the manifest hash of both datasets: queries are pinned to them, so a wrong one fails.
PRICETAG_DATASET_HASH=
PRICETAG_FORK_DATASET=
PRICETAG_FORK_HASH=

# Buying in the Mac app, through Coinbase's hosted page. Only this server ever sees the key. Without one, Buy says it isn't set up.
# A Secret API Key from https://portal.cdp.coinbase.com/api-keys/secret, Ed25519 by default: its ID, and its secret.
COINBASE_ONRAMP_KEY_ID=
COINBASE_ONRAMP_KEY_SECRET=
# 1 asks Coinbase's page for its mocked mode, for rehearsing. Nothing's charged, and nothing arrives.
COINBASE_ONRAMP_MOCK=

# Hosting: one shared server instead of one on each Mac. See "Hosting" in the README. Leave all of this empty to run locally.
# 1 turns on everything a shared server needs at once: invites, limits, redacted JSON logs, binding to 0.0.0.0, and API only.
PRICETAG_HOSTED=
# Who may use it, as name:sha256 pairs separated by commas. `pnpm invite <name>` makes one. Remove a pair to take it back.
PRICETAG_INVITES=
# The header the host sets to the client's address, like fly-client-ip. Coinbase is told it, to check where a purchase is made from. A hosted server won't start without it.
PRICETAG_CLIENT_IP_HEADER=
# Per invite: requests a minute, live streams at once, Coinbase checkouts an hour. And checkouts a day, for everyone together.
PRICETAG_LIMIT_PER_MINUTE=
PRICETAG_LIMIT_STREAMS=
PRICETAG_LIMIT_CHECKOUTS_PER_HOUR=
PRICETAG_LIMIT_CHECKOUTS_PER_DAY=
# Wallets each pricing rule keeps read, 20 by default. One pushed out is read again in full, so a shared server wants more.
PRICETAG_MAX_WALLETS=
# How many people's Amp queries run at once, 3 by default. Each person's run one at a time. Lower it if Amp can't take that.
PRICETAG_AMP_LANES=
# 1 also serves the web app, which a hosted server doesn't by default.
PRICETAG_SERVE_APP=
# How long a shutdown waits for requests to finish, in milliseconds.
PRICETAG_DRAIN_MS=
# Where to listen. Defaults to 127.0.0.1, or 0.0.0.0 when hosted. Anything other machines can reach needs PRICETAG_INVITES.
HOST=

  "functions": {
    "pt_net": {
      "inputTypes": [
        "Utf8"
      ],
      "outputType": {
        "Struct": [
          {
            "name": "amount",
            "data_type": "Utf8",
            "nullable": true,
            "dict_id": 0,
            "dict_is_ordered": false,
            "metadata": {}
          },
          {
            "name": "side",
            "data_type": "Utf8",
            "nullable": true,
            "dict_id": 0,
            "dict_is_ordered": false,
            "metadata": {}
          }
        ]
      },
      "source": {
        "source": "\nfunction pt_net(amounts) {\n  const none = { amount: '', side: '' };\n  if (!amounts) return none;\n  let net = 0n, gross = 0n;\n  for (const part of String(amounts).split(',')) {\n    if (!/^-?\\d+$/.test(part)) return none;\n    const amount = BigInt(part);\n    net += amount;\n    gross += amount < 0n ? -amount : amount;\n  }\n  if (net === 0n) return none;\n  const size = net < 0n ? -net : net;\n  return { amount: size * 2n < gross ? '' : size.toString(), side: net > 0n ? 'credit' : 'debit' };\n}\n",
        "filename": "pt_net.js"
      }
    },
    "pt_native": {
      "inputTypes": [
        "Utf8",
        "Utf8",
        "Utf8",
        "Utf8"
      ],
      "outputType": "Utf8",
      "source": {
        "source": "\nfunction pt_native(side, amount, amount0, amount1) {\n  if (!/^\\d+$/.test(String(amount)) || !/^-?\\d+$/.test(String(amount0)) || !/^-?\\d+$/.test(String(amount1))) return '';\n  const token = BigInt(amount1), eth = BigInt(amount0);\n  const gave = side === 'debit';\n  if (gave ? token <= 0n || eth >= 0n : token >= 0n || eth <= 0n) return '';\n  if ((token < 0n ? -token : token) !== BigInt(amount)) return '';\n  return (eth < 0n ? -eth : eth).toString();\n}\n",
        "filename": "pt_native.js"
      }
    },
    "pt_trade": {
      "inputTypes": [
        "Utf8",
        "Utf8",
        "Utf8",
        "Utf8"
      ],
      "outputType": "Utf8",
      "source": {
        "source": "\nfunction pt_trade(quoteToken, quoteAmount, ethUsd, usdcUsd) {\n  const token = String(quoteToken).replace(/^0x/, '').toLowerCase();\n  const usdc = token === '833589fcd6edb6e08f4c7c32d4f71b54bda02913';\n  const answer = usdc ? usdcUsd : ethUsd;\n  if (!/^\\d+$/.test(String(quoteAmount)) || !/^\\d+$/.test(String(answer))) return '';\n  if (!usdc && token !== '4200000000000000000000000000000000000006' && token !== '0000000000000000000000000000000000000000') return '';\n  return (BigInt(quoteAmount) * BigInt(answer) / (10n ** BigInt(usdc ? 8 : 20))).toString();\n}\n",
        "filename": "pt_trade.js"
      }
    }
  }

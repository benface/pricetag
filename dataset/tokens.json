    "pool_trades": {
      "input": {
        "sql": "SELECT block_num, timestamp, tx_hash, pool, token, token_amount, side, quote_token, quote_amount FROM (\n  SELECT block_num, timestamp, tx_hash, pool,\n    CASE WHEN got_token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913') THEN gave_token ELSE got_token END AS token,\n    CASE WHEN got_token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913') THEN gave_amount ELSE got_amount END AS token_amount,\n    CASE WHEN got_token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913') THEN 'buy' ELSE 'sell' END AS side,\n    CASE WHEN got_token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913') THEN got_token ELSE gave_token END AS quote_token,\n    CASE WHEN got_token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913') THEN got_amount ELSE gave_amount END AS quote_amount\n  FROM self.trade_pairs\n  UNION ALL\n  SELECT block_num, timestamp, tx_hash, pool, token, token_amount, side, arrow_cast(X'0000000000000000000000000000000000000000', 'FixedSizeBinary(20)') AS quote_token, quote_amount FROM self.v4_native_trades WHERE quote_amount <> ''\n) WHERE block_num() >= 53515446"

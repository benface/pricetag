    "v4_single_moves": {
      "input": {
        "sql": "SELECT m.block_num, m.timestamp, m.tx_hash, m.account, m.token, m.side, m.amount\nFROM self.pool_moves m\nJOIN self.move_counts c ON m._block_num = c._block_num AND m.tx_hash = c.tx_hash AND m.account = c.account\nWHERE c.moves = 1 AND m.account = X'498581ff718922c3f8e6a244956af099b2652b2b' AND m.amount <> '' AND m.token NOT IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913') AND block_num() >= 53515446"

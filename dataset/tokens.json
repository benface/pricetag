    "v4_native_trades": {
      "input": {
        "sql": "SELECT m.block_num, m.timestamp, m.tx_hash, m.account AS pool, m.token AS token, m.amount AS token_amount, CASE WHEN m.side = 'debit' THEN 'buy' ELSE 'sell' END AS side,\n  self.pt_native(m.side, m.amount, s.amount0, s.amount1) AS quote_amount\nFROM self.v4_single_moves m\nJOIN self.v4_swaps s ON m._block_num = s._block_num AND m.tx_hash = s.tx_hash\nWHERE block_num() >= 53515446"

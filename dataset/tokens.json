    "trade_pairs": {
      "input": {
        "sql": "SELECT a.block_num, a.timestamp, a.tx_hash, a.account AS pool, a.token AS gave_token, a.amount AS gave_amount, b.token AS got_token, b.amount AS got_amount\nFROM self.single_moves a\nJOIN self.single_moves b ON a._block_num = b._block_num AND a.tx_hash = b.tx_hash AND a.account = b.account\nWHERE a.side = 'debit' AND b.side = 'credit' AND (a.token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913')) <> (b.token IN (X'0000000000000000000000000000000000000000', X'4200000000000000000000000000000000000006', X'833589fcd6edb6e08f4c7c32d4f71b54bda02913')) AND block_num() >= 53515446"

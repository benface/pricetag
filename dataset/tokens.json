    "v4_swaps": {
      "input": {
        "sql": "SELECT block_num, tx_hash, swaps, amount0, amount1 FROM (\n  SELECT block_num, tx_hash, COUNT(*) AS swaps, min(amount0) AS amount0, min(amount1) AS amount1 FROM (\n    SELECT block_num, tx_hash, arrow_cast(get_field(t, 'amount0'), 'Utf8') AS amount0, arrow_cast(get_field(t, 'amount1'), 'Utf8') AS amount1 FROM (\n      SELECT block_num, tx_hash, evm_decode_log(topic1, topic2, topic3, data, 'Swap(bytes32 indexed id, address indexed sender, int128 amount0, int128 amount1, uint160 sqrtPriceX96, uint128 liquidity, int24 tick, uint24 fee)') AS t FROM base.logs\n      WHERE address = X'498581ff718922c3f8e6a244956af099b2652b2b' AND topic0 = evm_topic('Swap(bytes32 indexed id, address indexed sender, int128 amount0, int128 amount1, uint160 sqrtPriceX96, uint128 liquidity, int24 tick, uint24 fee)')\n    )\n  ) GROUP BY block_num(), block_num, tx_hash\n) WHERE swaps = 1 AND block_num() >= 53515446"
      },

{
  "name": "pricetag",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --test 'test/**/*.test.ts' && vite build",
    "amp:start": "scripts/amp start",
    "amp:stop": "scripts/amp stop",
    "example": "node --env-file-if-exists=.env.local packages/sdk/examples/portfolio.ts"
  },
  "dependencies": {
    "@pricetag/sdk": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

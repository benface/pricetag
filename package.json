{
  "name": "pricetag",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.ts",
    "invite": "node scripts/invite.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --test 'test/**/*.test.ts' && vite build",
    "mac": "macos/run.sh",
    "mac:build": "macos/run.sh --build-only",
    "mac:shot": "macos/shot.sh",
    "mac:watch-only": "macos/watch-only.sh",
    "check:mac": "macos/check-mac.sh",
    "check:mac:quick": "macos/check-mac.sh --quick",
    "check:swift-queue": "node macos/swift-queue.test.ts",
    "check:anvil": "macos/anvil-test.sh",
    "check:keychain": "macos/keychain-test.sh",
    "check:watch-only": "macos/watch-only-test.sh",
    "check:extension": "macos/extension-test.sh",
    "check:tax-answer": "node scripts/tax-answer-e2e.ts",
    "check:job-watch": "scripts/job-watch-local.sh",
    "amp:start": "scripts/amp start",
    "amp:stop": "scripts/amp stop",
    "example": "node --env-file-if-exists=.env.local packages/sdk/examples/portfolio.ts",
    "example:watch": "node --env-file-if-exists=.env.local packages/sdk/examples/watch.ts"
  },
  "dependencies": {
    "@keystonehq/animated-qr": "0.10.0",
    "@keystonehq/keystone-sdk": "0.13.0",
    "@ledgerhq/context-module": "2.8.0",
    "@ledgerhq/device-management-kit": "1.11.0",
    "@ledgerhq/device-signer-kit-ethereum": "1.18.2",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@pricetag/sdk": "workspace:*",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "readable-stream": "3.6.2",
    "rxjs": "7.8.2",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "apache-arrow": "21.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

// The app's name lives here and nowhere else: change this line to rename it everywhere.
APP_NAME = Patina

PRODUCT_NAME = $(APP_NAME)
PRODUCT_MODULE_NAME = MacApp
// Not .mac, which our personal team registered, so no other team can have it. A bundle ID belongs to one team for good.
APP_BUNDLE_ID = com.benface.pricetag.macos.wallet
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
// A debug build gets its own settings and records, so trying things can't touch the real wallet.
APP_DEBUG_BUNDLE_ID = com.benface.pricetag.macos.debug
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = $(APP_DEBUG_BUNDLE_ID)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Patina's own server, by host name, which it always reaches over HTTPS. Empty reads the server `pnpm mac` runs on this Mac.
// It stays empty here, so `pnpm mac` keeps the local server. Settings can still point the app elsewhere.
PATINA_SERVER_HOST =
// The hosted server. The builds for other people set PATINA_SERVER_HOST to this, and no other build reads it.
PATINA_HOSTED_SERVER_HOST = patina-server.fly.dev

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
// The only thing copied is the bridge host, which is signed, so it can't be stripped here and Xcode warns each time it's asked to.
COPY_PHASE_STRIP = NO
// This target's only script is copy-device-pages.sh, which copies a folder whose files aren't known until it's built. The sandbox only allows named files.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// A menu bar app with no Dock icon until its window opens. See DockPresence.swift.
GENERATE_INFOPLIST_FILE = YES
APP_INFOPLIST = Config/Info.plist
INFOPLIST_FILE = $(APP_INFOPLIST)
INFOPLIST_KEY_CFBundleDisplayName = $(APP_NAME)
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.finance
INFOPLIST_KEY_NSHumanReadableCopyright =

// Sandboxed, and its only permissions are to open connections, to read or write a file the user picks in a dialog, which is how an
// exchange history comes in and a CSV goes out, and the camera, which reads a Keystone's address. It touches no other files but its own.
// It only accepts connections for a device page, on 127.0.0.1, for as long as that page is open. See DevicePageServer.swift.
ENABLE_APP_SANDBOX = YES
ENABLE_USER_SELECTED_FILES = readwrite
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_INCOMING_NETWORK_CONNECTIONS = YES
ENABLE_RESOURCE_ACCESS_CAMERA = YES
INFOPLIST_KEY_NSCameraUsageDescription = Reads the address on your hardware wallet's screen. The picture stays on this Mac, and nothing's saved.
ENABLE_HARDENED_RUNTIME = YES

// run.sh swaps in a real identity when there is one, so a rebuild keeps access to the app's saved settings. With the team
// it's pinned to, it also adds Config/HotWallet.entitlements and a profile that allows them, which lets the app hold a key.
// These go through their own names because a setting on xcodebuild's command line would also apply to every package target.
APP_SIGN_STYLE = Manual
APP_SIGN_IDENTITY = -
APP_TEAM =
APP_ENTITLEMENTS =
APP_INJECT_BASE_ENTITLEMENTS = YES
CODE_SIGN_STYLE = $(APP_SIGN_STYLE)
CODE_SIGN_IDENTITY = $(APP_SIGN_IDENTITY)
DEVELOPMENT_TEAM = $(APP_TEAM)
CODE_SIGN_ENTITLEMENTS = $(APP_ENTITLEMENTS)
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = $(APP_INJECT_BASE_ENTITLEMENTS)

// The fixtures macos/shot.sh uses. The code that reads them compiles to nothing outside of debug builds.
EXCLUDED_SOURCE_FILE_NAMES[config=Release] = */TestMode/*

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
COMBINE_HIDPI_IMAGES = YES
ALWAYS_SEARCH_USER_PATHS = NO
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks

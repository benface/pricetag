<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.benface.pricetag.hotwallet</string>
	</array>
	<!-- Only for the socket the extension's host connects to. See BridgeEndpoint. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.benface.pricetag.bridge</string>
	</array>
</dict>
</plist>
